#!@python@/bin/python3
"""Single entry point for managing this NixOS machine.

Covers rebuilding, the runtime work/private profile switch, generation
housekeeping and generation diffs. The machine specific facts (flake path,
host name, whether a work specialisation exists, tool paths) come from a JSON
file generated by config/nixos/sysman.nix.
"""

import argparse
import fnmatch
import json
import os
import subprocess
import sys
import time
from pathlib import Path

CONFIG_FILE = Path('@config@')

PROFILE_DIR = Path('/nix/var/nix/profiles')
# The system profile keeps pointing at the parent generation even while the
# specialisation is live, which is what makes the way back to private work.
SYSTEM_PROFILE = PROFILE_DIR / 'system'
CURRENT_SYSTEM = Path('/run/current-system')
BOOTED_SYSTEM = Path('/run/booted-system')
# Runtime marker written by work-profile.nix: "private" or "work".
PROFILE_MARKER = Path('/etc/nixos-profile')
USER_PROFILE = Path.home() / '.local/state/nix/profiles/profile'

WORK = 'work'
PRIVATE = 'private'

GEN_DAYS = 20
SYSTEM_KEEP = 3

# Units that are never restarted by the automatic retry: restarting them tears
# down the graphical session, the network or the login the retry runs from.
RETRY_EXCLUDE = (
    'NetworkManager.service',
    'dbus-broker.service',
    'dbus.service',
    'display-manager.service',
    'getty@*.service',
    'systemd-logind.service',
    'user@*.service',
)


def say(message):
    print(f'\n==> {message}', flush=True)


def warn(message):
    print(f'sysman: {message}', file=sys.stderr, flush=True)


def die(message):
    warn(message)
    sys.exit(1)


def as_root(command):
    """Prefix a command with sudo, unless already root.

    Root runs it directly, so the tool also works on machines that only have
    a root login.
    """
    if os.geteuid() == 0:
        return list(command)
    return ['sudo', *command]


def run(command, check=True):
    """Run a command attached to the terminal and return its exit status."""
    status = subprocess.run(command).returncode
    if check and status != 0:
        die(f"'{' '.join(command)}' failed with status {status}")
    return status


def capture(command):
    """Return the stdout of a command, empty if it fails."""
    result = subprocess.run(
        command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
    )
    return result.stdout if result.returncode == 0 else ''


def load_config():
    with CONFIG_FILE.open() as handle:
        return json.load(handle)


def live_profile():
    """The profile the running system reports, None without a marker."""
    try:
        return PROFILE_MARKER.read_text().strip()
    except OSError:
        return None


def toplevel_of(profile, generation=SYSTEM_PROFILE):
    """Toplevel of the given profile inside a system generation."""
    if profile == WORK:
        return generation / 'specialisation' / WORK
    return generation


def failed_units():
    output = capture(
        [
            'systemctl',
            'list-units',
            '--failed',
            '--plain',
            '--no-legend',
            '--no-pager',
        ]
    )
    return {line.split()[0] for line in output.splitlines() if line.strip()}


def retry_failed(units):
    """Restart each failed unit once and return the ones still failed.

    Services changed by a switch fail their restart at random while nothing is
    actually wrong with them, and a second attempt usually goes through.
    """
    still_failed = set()
    for unit in sorted(units):
        if any(fnmatch.fnmatch(unit, pattern) for pattern in RETRY_EXCLUDE):
            warn(f'{unit} failed, not retried automatically')
            still_failed.add(unit)
            continue
        print(f'retrying {unit}', flush=True)
        if run(as_root(['systemctl', 'restart', unit]), check=False) != 0:
            still_failed.add(unit)
    return still_failed


def resettle_network(cfg):
    """Poke the daemons that read files under /etc only once at startup.

    switch-to-configuration only restarts units whose definition changed, and
    the work and private profiles have an identical unit graph: they differ
    only in files under /etc.
    """
    nmcli = cfg['nmcli']

    # NM caches system-connections in memory: without this the work connections
    # linger after leaving work mode and are absent after entering it.
    run(as_root([nmcli, 'connection', 'reload']), check=False)

    # resolved parses /etc/dnssec-trust-anchors.d only at startup, so the
    # ig.local anchor appears (or disappears) for it only across a restart.
    run(as_root(['systemctl', 'restart', 'systemd-resolved']), check=False)

    # That restart wipes the per-link DNS overrides the dnscrypt dispatcher
    # installs (see laptop/dnscrypt.nix). Reapplying each connected physical
    # link re-runs the dispatcher and restores them.
    devices = capture([nmcli, '-t', '-f', 'DEVICE,TYPE,STATE', 'device'])
    for line in devices.splitlines():
        fields = line.split(':')
        if len(fields) < 3:
            continue
        device, kind, state = fields[0], fields[1], fields[2]
        if state == 'connected' and kind in ('wifi', 'ethernet'):
            run(as_root([nmcli, 'device', 'reapply', device]), check=False)


def poke_awesome(cfg):
    """Tell the running awesome instance to re-read the profile.

    awesome tints its wibar and client borders by profile, read from
    /etc/nixos-profile at startup. That file is a symlink which setup-etc
    swaps out, so inotify on the path is unreliable. Without a session bus
    (TTY, ssh) there is no awesome to poke, and its own 5-minute fallback
    timer covers a missed poke anyway.
    """
    if not cfg.get('awesome_client') or not os.environ.get(
        'DBUS_SESSION_BUS_ADDRESS'
    ):
        return
    subprocess.run(
        [cfg['awesome_client'], 'nixos_profile.refresh()'],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def relink_skills(cfg, prune):
    """Relink skillissue skills after a profile change.

    The HM half of the work profile adds the inno repo to
    skillissue/config.yaml (config/home/inno.nix), but writing that file links
    nothing by itself. `link` is the offline phase only: it creates symlinks
    for repos already in the cache and GCs the ones that left the config, so
    it is safe in both directions and needs no VPN.

    Runs unprivileged on purpose: the cache, the symlink targets and the ssh
    agent all belong to the invoking user, not to root.

    With prune the work skill content is taken off disk as well, not just the
    symlinks. skillissue refuses to delete a clone with uncommitted or
    unpushed work, so an unsynced skill blocks the removal instead of being
    lost.
    """
    if not cfg.get('skillissue'):
        return
    command = [cfg['skillissue'], 'link']
    if prune:
        command.append('--prune-cache')
    run(command, check=False)


def activate(cfg, toplevel):
    """Activate a toplevel on the running system and settle it afterwards.

    Returns True when the system ended up clean. Whether the switch happened
    is read from /run/current-system and not from the exit status, because
    switch-to-configuration also exits non-zero when the switch went through
    and only some unit failed to restart.
    """
    target = toplevel.resolve()
    failed_before = failed_units()

    say(f'activating {target}')
    # A transient unit keeps the activation alive when the terminal it was
    # started from dies halfway, e.g. because the display manager restarts.
    # `test` activates without touching the bootloader, which nixos-rebuild
    # boot has already written.
    status = run(
        as_root(
            [
                'systemd-run',
                '--collect',
                '--no-ask-password',
                '--pipe',
                '--quiet',
                '--service-type=exec',
                '--unit=sysman-switch-to-configuration',
                '--wait',
                str(target / 'bin' / 'switch-to-configuration'),
                'test',
            ]
        ),
        check=False,
    )

    if CURRENT_SYSTEM.resolve() != target:
        die(
            f'activation failed with status {status} and the running system '
            'is unchanged, nothing else was touched'
        )

    still_failed = set()
    new_failed = failed_units() - failed_before
    if new_failed:
        say('retrying units that failed during activation')
        still_failed = retry_failed(new_failed)

    if cfg['network_manager']:
        say('resettling network daemons')
        resettle_network(cfg)
    poke_awesome(cfg)

    if still_failed:
        warn('still failed: ' + ', '.join(sorted(still_failed)))
        return False
    if status != 0 and not new_failed:
        warn(
            f'switch-to-configuration exited with status {status} without a '
            'failed unit, check its output above'
        )
        return False
    return True


def print_work_hints():
    print()
    print('Work profile active.')
    print('  Restart Firefox/Chromium: a running browser read the CA store at')
    print('  startup and cannot see the work CAs that just appeared.')
    print('  VPN is not brought up automatically: nmcli connection up IG-WG-1')
    print('  Work skills are linked from the local skillissue cache; run')
    print("  'skillissue update' once the VPN is up to clone/pull them.")


def print_private_hints():
    print()
    print('Private profile active. Work CAs and connections are gone from')
    print('/etc; restart browsers if you want them to forget the CAs too.')


def cmd_up(cfg, args):
    flake_path = cfg['flake_path']

    if not args.no_update:
        say('updating flake inputs')
        run(['nix', 'flake', 'update', '--flake', flake_path])

    before = live_profile()

    say('building the system and setting it as boot default')
    # path:// copies the working tree as is, so the gitignored secrets.nix is
    # part of the evaluation.
    run(
        as_root(
            [
                'nixos-rebuild',
                'boot',
                '--flake',
                f'path://{flake_path}#{cfg["hostname"]}',
                '--verbose',
                '--option',
                'eval-cache',
                'false',
            ]
        )
    )

    # nixos-rebuild knows only the parent system, so the profile that is live
    # has to be picked from the new generation here to stay in it.
    wanted = PRIVATE
    if before == WORK:
        if toplevel_of(WORK).is_dir():
            wanted = WORK
        else:
            warn(
                'the new generation has no work specialisation, '
                'dropping to the private profile'
            )

    if cfg['work_specialisation']:
        say(
            f'profile before the rebuild: {before or "unknown"}, '
            f'activating: {wanted}'
        )
    clean = activate(cfg, toplevel_of(wanted))

    if before == WORK and wanted == PRIVATE:
        relink_skills(cfg, prune=True)
        print_private_hints()

    return 0 if clean else 1


def cmd_work(cfg, args):
    if not cfg['work_specialisation']:
        die('this machine has no work specialisation')

    if args.state is None:
        print(f'profile: {live_profile() or "unknown"}')
        return 0

    wanted = WORK if args.state == 'on' else PRIVATE
    toplevel = toplevel_of(wanted)
    if not toplevel.is_dir():
        die(f"{toplevel} does not exist, rebuild first with 'sysman up'")

    # The marker alone is not enough: after an interrupted switch it can
    # already name the wanted profile while the running system is another one.
    if (
        live_profile() == wanted
        and CURRENT_SYSTEM.resolve() == toplevel.resolve()
    ):
        print(f'Already in {wanted} profile.')
        return 0

    clean = activate(cfg, toplevel)
    relink_skills(cfg, prune=wanted == PRIVATE)
    if wanted == WORK:
        print_work_hints()
    else:
        print_private_hints()
    return 0 if clean else 1


def system_generations():
    """Sorted list of (number, link path) for the system profile."""
    generations = []
    for link in PROFILE_DIR.glob('system-*-link'):
        number = link.name.removeprefix('system-').removesuffix('-link')
        if number.isdigit():
            generations.append((int(number), link))
    return sorted(generations)


def describe_running(cfg):
    """Name what the running system is, relative to the system profile."""
    running = CURRENT_SYSTEM.resolve()
    if running == SYSTEM_PROFILE.resolve():
        return 'system profile' + (
            ', private' if cfg['work_specialisation'] else ''
        )
    work = toplevel_of(WORK)
    if work.is_dir() and running == work.resolve():
        return 'system profile, work specialisation'
    for number, link in reversed(system_generations()):
        if running == link.resolve():
            return f'generation {number}, NOT the system profile'
        older_work = toplevel_of(WORK, link)
        if older_work.is_dir() and running == older_work.resolve():
            return f'generation {number} work specialisation, NOT the system profile'
    return 'NOT the system profile or any of its generations'


def cmd_status(cfg, args):
    running_note = describe_running(cfg)
    print(f'host:     {cfg["hostname"]}')
    if PROFILE_MARKER.exists():
        print(f'profile:  {live_profile()}')
    print(f'booted:   {BOOTED_SYSTEM.resolve()}')
    print(f'running:  {CURRENT_SYSTEM.resolve()}')
    print(f'          ({running_note})')
    print(f'default:  {SYSTEM_PROFILE.resolve()}')

    if 'NOT' in running_note:
        repair = (
            'sysman work on|off'
            if cfg['work_specialisation']
            else 'sysman up --no-update'
        )
        print()
        print(
            'The running system is not the one the system profile points at:'
        )
        print(
            'an activation was interrupted, or an older generation was booted.'
        )
        print(f"Activate the current one with '{repair}'.")

    current = SYSTEM_PROFILE.resolve()
    booted = BOOTED_SYSTEM.resolve()
    print('\nSystem generations:')
    for number, link in system_generations():
        built = time.strftime(
            '%Y-%m-%d %H:%M', time.localtime(link.lstat().st_mtime)
        )
        marks = []
        if link.resolve() == current:
            marks.append('current')
        if link.resolve() == booted:
            marks.append('booted')
        suffix = f'  ({", ".join(marks)})' if marks else ''
        print(f'  {number:>5}  {built}{suffix}')

    failed = failed_units()
    if failed:
        print('\nFailed units:')
        for unit in sorted(failed):
            print(f'  {unit}')

    if USER_PROFILE.is_symlink():
        print('\nAd-hoc (nix profile):', flush=True)
        run(['nix', 'profile', 'list'], check=False)
    return 0


def cmd_clean(cfg, args):
    say(f'system profile: keeping the newest {SYSTEM_KEEP} generations')
    run(
        as_root(
            [
                'nix-env',
                '-p',
                str(SYSTEM_PROFILE),
                '--delete-generations',
                f'+{SYSTEM_KEEP}',
            ]
        )
    )

    if USER_PROFILE.is_symlink():
        say(
            f'ad-hoc user profile: dropping generations older than {GEN_DAYS}d'
        )
        run(
            [
                'nix',
                'profile',
                'wipe-history',
                '--profile',
                str(USER_PROFILE),
                '--older-than',
                f'{GEN_DAYS}d',
            ]
        )

    say('collecting garbage')
    # Not fatal: an optimise pass is still worth having.
    if run(as_root(['nix-collect-garbage']), check=False) != 0:
        warn('nix-collect-garbage failed, optimising the store anyway')

    say('deduplicating the store')
    run(as_root(['nix-store', '--optimize']))
    return 0


def resolve_generation(spec):
    """Turn a generation number or a path into a path that exists."""
    path = (
        PROFILE_DIR / f'system-{spec}-link' if spec.isdigit() else Path(spec)
    )
    if not path.exists():
        die(f'no such generation or path: {spec}')
    return path


def cmd_diff(cfg, args):
    if len(args.generations) > 2:
        die('diff takes at most two generations')

    generations = system_generations()
    if len(args.generations) == 2:
        old, new = (resolve_generation(spec) for spec in args.generations)
    elif len(args.generations) == 1:
        old = resolve_generation(args.generations[0])
        new = generations[-1][1] if generations else SYSTEM_PROFILE
    else:
        if len(generations) < 2:
            die('fewer than two system generations, nothing to compare')
        old, new = generations[-2][1], generations[-1][1]

    return run([cfg['nvd'], 'diff', str(old), str(new)], check=False)


def build_parser(cfg):
    parser = argparse.ArgumentParser(
        prog='sysman', description='Manage this NixOS machine.'
    )
    commands = parser.add_subparsers(dest='command', required=True)

    up = commands.add_parser(
        'up',
        help='update flake inputs, rebuild and activate, staying in the live profile',
    )
    up.add_argument(
        '--no-update',
        action='store_true',
        help='rebuild without updating flake inputs',
    )
    up.set_defaults(handler=cmd_up)

    if cfg['work_specialisation']:
        work = commands.add_parser(
            'work',
            help='switch the work profile on or off at runtime, no rebuild',
            description='Without an argument: print which profile is live.',
        )
        work.add_argument('state', nargs='?', choices=('on', 'off'))
        work.set_defaults(handler=cmd_work)

    status = commands.add_parser(
        'status',
        help='live profile, running system, generations and failed units',
    )
    status.set_defaults(handler=cmd_status)

    clean = commands.add_parser(
        'clean',
        help='drop old generations, collect garbage, optimise the store',
    )
    clean.set_defaults(handler=cmd_clean)

    diff = commands.add_parser(
        'diff',
        help='package diff between two system generations',
        description=(
            'Without arguments: the previous generation against the newest. '
            'One argument: that generation against the newest. '
            'Two arguments: the first against the second.'
        ),
    )
    diff.add_argument(
        'generations',
        nargs='*',
        metavar='GENERATION',
        help='generation number or path',
    )
    diff.set_defaults(handler=cmd_diff)

    return parser


def main():
    cfg = load_config()
    args = build_parser(cfg).parse_args()
    try:
        return args.handler(cfg, args)
    except KeyboardInterrupt:
        return 130


if __name__ == '__main__':
    sys.exit(main())
