#!/usr/bin/env bash
# dnsmagic-pause: disable dnscrypt-proxy and force DHCP DNS on all physical interfaces
# Usage: sudo dnsmagic-pause

set -euo pipefail

# Commands with paths (for systemd-resolved systemctl, etc.)
nmcli="@networkmanager@/bin/nmcli"
resolvectl="@systemd@/bin/resolvectl"
systemctl="@systemd@/bin/systemctl"
logger="@util-linux@/bin/logger"
kdig="@knot-dns@/bin/kdig"

DISABLE_FILE="/run/dnscrypt-override.disabled"

# Write the override file
touch "$DISABLE_FILE"
$logger -t dnsmagic-pause "touched $DISABLE_FILE"

# Source the library and apply pause mode
source /etc/dnsmagic/dnsmagic-lib.sh
apply_policy_all pause