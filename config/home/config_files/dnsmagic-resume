#!/usr/bin/env bash
# dnsmagic-resume: re-enable dnscrypt-proxy and apply normal DNS policy
# Usage: dnsmagic-resume

set -euo pipefail

# Commands with paths (for systemd-resolved systemctl, etc.)
nmcli="@networkmanager@/bin/nmcli"
resolvectl="@systemd@/bin/resolvectl"
systemctl="@systemd@/bin/systemctl"
logger="@util-linux@/bin/logger"
kdig="@knot-dns@/bin/kdig"
sleep="@coreutils@/bin/sleep"
# Must be the NixOS security wrapper, not the plain store path: only the
# wrapper is owned by root with the setuid bit, the store binary refuses to run.
sudo="/run/wrappers/bin/sudo"

# Removing /run override file needs root; re-exec via sudo when not already root.
# EUID is a bash builtin, so this needs no external binaries.
# sudo var must be bound above: running under `set -u` (set -euo pipefail).
if (( EUID != 0 )); then
  exec "$sudo" "$0" "$@"
fi

DISABLE_FILE="/run/dnscrypt-override.disabled"

# Remove the override file
rm -f "$DISABLE_FILE"
$logger -t dnsmagic-resume "removed $DISABLE_FILE"

# Source the library and apply resume mode (with fresh connectivity check)
source /etc/dnsmagic/dnsmagic-lib.sh
apply_policy_all resume